# Supabase — copy to mobile/.env and supabase/.env.local

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_PHONE_SALT=random-secret-for-phone-hashing
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Must match subscription product ID in Play Console + App Store Connect
EXPO_PUBLIC_IAP_PRODUCT_ID=bonfire.pro.monthly

# Supabase Edge Functions (set via supabase secrets)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APPLE_BUNDLE_ID=app.bonfire.ios
